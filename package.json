{
  "name": "dsh-crystra",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "build": "node scripts/build-client-bundles.mjs && node scripts/verify-foundation.mjs",
    "test": "node --test test/*.test.mjs modules/*/test/*.test.mjs modules/execution/src/client/delivery-inventory/*.test.js",
    "test:foundation": "node --test test/foundation.test.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "version:check": "node scripts/verify-foundation.mjs --version-only",
    "pack:verify": "node scripts/verify-packages.mjs",
    "provenance:verify": "node scripts/verify-provenance.mjs",
    "qualify:clean-profile": "node scripts/qualify-clean-profile.mjs",
    "qualify:lifecycle": "node scripts/qualify-lifecycle.mjs",
    "qualify:provider-routing": "node scripts/qualify-provider-routing.mjs",
    "qualify:real-harness": "node scripts/qualify-real-harness.mjs",
    "studio:dev": "node scripts/serve-studio-dev-harness.mjs",
    "release:candidate": "node scripts/build-release-candidate.mjs",
    "release:owner:verify": "node scripts/verify-foundation.mjs",
    "release:qualify": "node scripts/write-release-qualification.mjs",
    "release:verify": "node scripts/verify-release-set.mjs",
    "inputs:prepare": "node scripts/prepare-development-artifacts.mjs",
    "qualify:initialization-services": "node scripts/qualify-initialization-services.mjs",
    "typecheck:workbench": "tsc -p tsconfig.workbench.json"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@shikijs/langs": "4.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "esbuild": "0.25.9",
    "immer": "^10.1.1",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.4.3",
    "typescript": "^6.0.3",
    "zustand": "^4.4.7"
  },
  "description": "Crystra workflow execution and analysis for DeepSeek Harness.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "modules/execution/src",
    "modules/studio/src",
    "modules/initialization/src",
    "skills",
    "cordis.patch.yml",
    "NOTICE.md",
    "README.md",
    "!modules/**/*.test.js"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "crystra-execution": "file:.crystra-inputs/crystra-execution-0.1.0.tgz",
    "crystra-ui-core": "file:.crystra-inputs/crystra-ui-core-0.1.0.tgz",
    "tar": "7.5.21"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.5-rc.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firestige/crystra-dsh.git"
  }
}
