{
  "status": "accepted-ui-design",
  "runtimeStatus": "host-adapter-pending",
  "brand": "Crystra",
  "themeScope": "data-crystra-theme=\"dark\"",
  "ownership": {
    "sharedComponents": "crystra-ui (current package crystra-ui-core)",
    "host": "DSH conversation, Composer, settings, file picker, session restoration",
    "workflow": "one workflow-package workspace"
  },
  "sidebar": {
    "expandedDefault": true,
    "railWidth": 64,
    "flyoutWidth": 300,
    "durationMs": 340,
    "railHitArea": 40,
    "sectionActionSize": 28,
    "sectionIconSize": 14,
    "sections": [
      "task-working-set",
      "workflow-navigation",
      "analysis-navigation"
    ],
    "sectionActions": [
      "search",
      "view",
      "browse-all"
    ],
    "footer": [
      "host-settings"
    ],
    "preserveOnCollapse": [
      "conversation",
      "draft",
      "selectedTask",
      "sectionPreferences"
    ],
    "flyoutOpen": "click-or-keyboard-not-hover",
    "escapeOrder": [
      "inner-search-or-menu",
      "flyout"
    ],
    "restoreFocus": "trigger",
    "brandExpanded": "toggle-crystra-dsh-surface",
    "brandCollapsed": "expand-sidebar-only"
  },
  "workflowSplit": {
    "chatMin": 360,
    "chatMaxFraction": 0.5,
    "keyboardStep": 16,
    "views": [
      "studio",
      "resources",
      "crystallization"
    ]
  },
  "files": {
    "import": "host-file-picker",
    "export": "direct-download",
    "markdown": "host-MarkdownText",
    "editing": "CodeMirror-source-only"
  },
  "source": "crystra/docs/design/crystra-ui/components/shell-and-sidebar.md"
}